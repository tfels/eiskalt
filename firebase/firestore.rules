rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Access is granted if a document members/<uid> exists.
    // Members are maintained manually via the Firebase console.
    function isMember() {
      return request.auth != null
        && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    // Access to a household is granted if a document households/<hid>/members/<uid> exists.
    function isMemberOf(hid) {
      return request.auth != null
        && exists(/databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid));
    }

    function isValidName(name) {
      return name is string && name.size() > 0 && name.size() <= 100;
    }

    // ----- households -----

    match /households/{hid} {
      allow read: if isMemberOf(hid);

      // any registered user can create a household, they become its owner and first member
      // (the membership must be created in the same batch)
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['name', 'createdBy', 'ownerId'])
        && isValidName(request.resource.data.name)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid
        && existsAfter(/databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid));

      match /members/{uid} {
        allow read: if isMemberOf(hid);

        // the creator of a new household adds itself as first member (in the same batch)
        allow create: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['uid', 'name'])
          && request.resource.data.uid == uid
          && isValidName(request.resource.data.name)
          && !exists(/databases/$(database)/documents/households/$(hid))
          && getAfter(/databases/$(database)/documents/households/$(hid)).data.ownerId == uid;
      }

      match /lists/{listId} {
        allow read, write: if isMemberOf(hid);

        match /items/{itemId} {
          allow read, write: if isMemberOf(hid);
        }
      }

      match /groups/{groupId} {
        allow read, write: if isMemberOf(hid);
      }
    }

    // ----- old data model (until the data is migrated into a household) -----

    match /lists/{listId} {
      allow read, write: if isMember();

      match /items/{itemId} {
        allow read, write: if isMember();
      }
    }

    match /groups/{groupId} {
      allow read, write: if isMember();
    }

    // Per-user data (settings, folded groups): each member only accesses their own document.
    match /users/{uid} {
      allow read, write: if isMember() && request.auth.uid == uid;
    }

    // members/** has no rule, so no client access.
    // The member list is maintained only via the console (or Admin SDK).
  }
}

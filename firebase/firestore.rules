rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Access is granted if a document members/<uid> exists ("registered").
    // Created by the user when joining the first household, or manually via the Firebase console.
    function isMember() {
      return request.auth != null
        && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    // Access to a household is granted if a document households/<hid>/members/<uid> exists.
    function isMemberOf(hid) {
      return request.auth != null
        && exists(/databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid));
    }

    // a household has exactly one owner, stored in households/<hid>.ownerId
    function isOwnerOf(hid) {
      return request.auth != null
        && get(/databases/$(database)/documents/households/$(hid)).data.ownerId == request.auth.uid;
    }

    function isValidName(name) {
      return name is string && name.size() > 0 && name.size() <= 100;
    }

    // the e-mail address of the signed-in user in lowercase ('' if the token has none)
    function myEmail() {
      return request.auth.token.get('email', '').lower();
    }

    // An open invite for the signed-in user (with verified e-mail address) to the household,
    // used up (deleted) in the same batch
    function isValidInvite(hid, inviteId) {
      let invite = get(/databases/$(database)/documents/invites/$(inviteId)).data;
      return request.auth.token.get('email_verified', false) == true
        && invite.householdId == hid
        && invite.email == myEmail()
        && invite.expiresAt > request.time
        && !existsAfter(/databases/$(database)/documents/invites/$(inviteId));
    }

    // ----- global registration -----

    match /members/{uid} {
      // registering when joining the first household (in the same batch as the new membership)
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'householdId'])
        && isValidName(request.resource.data.name)
        && request.resource.data.email == myEmail()
        && !exists(/databases/$(database)/documents/households/$(request.resource.data.householdId)/members/$(uid))
        && existsAfter(/databases/$(database)/documents/households/$(request.resource.data.householdId)/members/$(uid));
    }

    // ----- households -----

    match /households/{hid} {
      allow read: if isMemberOf(hid);

      // any registered user can create a household, they become its owner and first member
      // (the membership must be created in the same batch)
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['name', 'createdBy', 'ownerId'])
        && isValidName(request.resource.data.name)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid
        && existsAfter(/databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid));

      // every member can rename the household,
      // only the owner can hand over the ownership (to another member)
      allow update: if isMemberOf(hid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'ownerId'])
        && isValidName(request.resource.data.name)
        && (request.resource.data.ownerId == resource.data.ownerId
            || (resource.data.ownerId == request.auth.uid
                && exists(/databases/$(database)/documents/households/$(hid)/members/$(request.resource.data.ownerId))));

      match /members/{uid} {
        allow read: if isMemberOf(hid);

        // join: the creator of a new household adds itself as first member (in the same batch),
        // or a user with a valid invite (used up in the same batch)
        allow create: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['uid', 'name', 'inviteId'])
          && request.resource.data.uid == uid
          && isValidName(request.resource.data.name)
          && ((!exists(/databases/$(database)/documents/households/$(hid))
               && getAfter(/databases/$(database)/documents/households/$(hid)).data.ownerId == uid)
              || isValidInvite(hid, request.resource.data.get('inviteId', '')));

        // members can change their own name
        allow update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
          && isValidName(request.resource.data.name);

        // leave (not the owner, it has to hand over the ownership first), or removed by the owner
        allow delete: if request.auth != null
          && ((request.auth.uid == uid && !isOwnerOf(hid))
              || (request.auth.uid != uid && isOwnerOf(hid)));
      }

      match /lists/{listId} {
        allow read, write: if isMemberOf(hid);

        match /items/{itemId} {
          allow read, write: if isMemberOf(hid);
        }
      }

      match /groups/{groupId} {
        allow read, write: if isMemberOf(hid);
      }
    }

    // ----- invites -----

    match /invites/{inviteId} {
      // every member can invite, valid for at most 7 days
      allow create: if isMemberOf(request.resource.data.householdId)
        && request.resource.data.keys().hasOnly(['householdId', 'email', 'invitedBy', 'expiresAt'])
        && request.resource.data.invitedBy == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.email == request.resource.data.email.lower()
        && request.resource.data.email.matches('[^@ ]+@[^@ ]+')
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(7, 'd');

      // readable and deletable by the invited user (find, decline)
      // and by the members of the household (list, revoke)
      allow read, delete: if request.auth != null
        && (resource.data.email == myEmail() || isMemberOf(resource.data.householdId));
    }

    // ----- old data model (until the data is migrated into a household) -----

    match /lists/{listId} {
      allow read, write: if isMember();

      match /items/{itemId} {
        allow read, write: if isMember();
      }
    }

    match /groups/{groupId} {
      allow read, write: if isMember();
    }

    // Per-user data (settings, folded groups): each member only accesses their own document.
    match /users/{uid} {
      allow read, write: if isMember() && request.auth.uid == uid;
    }
  }
}

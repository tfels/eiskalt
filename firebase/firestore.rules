rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Access is granted if a document members/<uid> exists.
    // Members are maintained manually via the Firebase console.
    function isMember() {
      return request.auth != null
        && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    // Access to a household is granted if a document households/<hid>/members/<uid> exists.
    function isMemberOf(hid) {
      return request.auth != null
        && exists(/databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid));
    }

    // ----- households -----

    match /households/{hid} {
      allow read: if isMemberOf(hid);

      match /members/{uid} {
        allow read: if isMemberOf(hid);
      }

      match /lists/{listId} {
        allow read, write: if isMemberOf(hid);

        match /items/{itemId} {
          allow read, write: if isMemberOf(hid);
        }
      }

      match /groups/{groupId} {
        allow read, write: if isMemberOf(hid);
      }
    }

    // ----- old data model (until the data is migrated into a household) -----

    match /lists/{listId} {
      allow read, write: if isMember();

      match /items/{itemId} {
        allow read, write: if isMember();
      }
    }

    match /groups/{groupId} {
      allow read, write: if isMember();
    }

    // Per-user data (settings, folded groups): each member only accesses their own document.
    match /users/{uid} {
      allow read, write: if isMember() && request.auth.uid == uid;
    }

    // members/** has no rule, so no client access.
    // The member list is maintained only via the console (or Admin SDK).
  }
}

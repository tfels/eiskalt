<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/AllListsFragment">

    <fragment
        android:id="@+id/AllListsFragment"
        android:name="de.felsernet.android.eiskalt.inventory.AllListsFragment"
        tools:layout="@layout/fragment_all_lists">
        <!-- no label: the (custom) title is set by AllListsFragment itself -->

        <action
            android:id="@+id/action_AllListsFragment_to_ItemListFragment"
            app:destination="@id/ItemListFragment" />
        <action
            android:id="@+id/action_AllListsFragment_to_ListDetailsFragment"
            app:destination="@id/ListDetailsFragment" />
    </fragment>
    <fragment
        android:id="@+id/ItemListFragment"
        android:name="de.felsernet.android.eiskalt.item.ItemListFragment"
        android:label="{listTitle}"
        tools:layout="@layout/fragment_item_list">

        <argument
            android:name="listInfo"
            app:argType="de.felsernet.android.eiskalt.inventory.ListInfo" />
        <!-- only used as title (label) -->
        <argument
            android:name="listTitle"
            app:argType="string"
            android:defaultValue="" />

        <action
            android:id="@+id/action_ItemListFragment_to_ItemDetailsFragment"
            app:destination="@id/ItemDetailsFragment" />
    </fragment>
    <fragment
        android:id="@+id/ItemDetailsFragment"
        android:name="de.felsernet.android.eiskalt.item.ItemDetailsFragment"
        tools:layout="@layout/fragment_item_details">

        <argument
            android:name="dataObject"
            app:argType="de.felsernet.android.eiskalt.item.Item"
            app:nullable="true"
            android:defaultValue="@null" />

        <action
            android:id="@+id/action_ItemDetailsFragment_to_ItemListFragment"
            app:destination="@id/ItemListFragment" />
    </fragment>
    <fragment
        android:id="@+id/GroupListFragment"
        android:name="de.felsernet.android.eiskalt.group.GroupListFragment"
        android:label="@string/title_groups"
        tools:layout="@layout/fragment_group_list">

        <action
            android:id="@+id/action_GroupListFragment_to_GroupDetailsFragment"
            app:destination="@id/GroupDetailsFragment" />
    </fragment>
    <fragment
        android:id="@+id/GroupDetailsFragment"
        android:name="de.felsernet.android.eiskalt.group.GroupDetailsFragment"
        android:label="@string/title_group"
        tools:layout="@layout/fragment_group_details">

        <argument
            android:name="dataObject"
            app:argType="de.felsernet.android.eiskalt.group.Group"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>
    <fragment
        android:id="@+id/ListDetailsFragment"
        android:name="de.felsernet.android.eiskalt.inventory.ListDetailsFragment"
        android:label="@string/title_list"
        tools:layout="@layout/fragment_list_details">

        <argument
            android:name="dataObject"
            app:argType="de.felsernet.android.eiskalt.inventory.ListInfo"
            app:nullable="true"
            android:defaultValue="@null" />

        <action
            android:id="@+id/action_ListDetailsFragment_to_AllListsFragment"
            app:destination="@id/AllListsFragment" />
    </fragment>
    <fragment
        android:id="@+id/DbStatisticsFragment"
        android:name="de.felsernet.android.eiskalt.settings.DbStatisticsFragment"
        android:label="@string/title_db_statistics"
        tools:layout="@layout/fragment_db_statistics" />
    <fragment
        android:id="@+id/SettingsFragment"
        android:name="de.felsernet.android.eiskalt.settings.SettingsFragment"
        android:label="@string/title_settings"
        tools:layout="@layout/fragment_settings" />
    <fragment
        android:id="@+id/HouseholdFragment"
        android:name="de.felsernet.android.eiskalt.household.HouseholdFragment"
        android:label="@string/title_household"
        tools:layout="@layout/fragment_household" />
</navigation>
